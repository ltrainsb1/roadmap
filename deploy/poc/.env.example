# Copy to deploy/poc/.env and replace every change-me value.

# Caddy's site address; a real host name gets a public certificate, localhost gets Caddy's own CA.
DOMAIN=localhost
# Where users reach the app. Also the WebAuthn origin, so it must match what the browser shows.
APP_ORIGIN=https://localhost

# MongoDB root account. MONGO_URI must carry the same credentials (URL-encode special characters).
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=change-me-mongo-password
MONGO_URI=mongodb://root:change-me-mongo-password@mongo:27017/?replicaSet=rs0&authSource=admin
MONGO_DB=roadmap

NODE_ENV=production
PORT=3000
# Generate with: openssl rand -base64 32
TOTP_ENC_KEY=change-me-run-openssl-rand-base64-32

# The file mailer needs no AWS credentials: mail lands in the container's tmpfs. Production uses ses.
MAILER=file
MAIL_OUTBOX_FILE=/tmp/outbox.jsonl
MAIL_FROM=no-reply@localhost
HIBP_ENABLED=true
AUTH_RATE_LIMIT_PER_MIN=10

# Files. The compose file sets FILES=s3, SCANNER=clamd and CLAMD_HOST=clamav; S3 credentials come from the instance role.
# The bucket for uploaded files; objects are written with SSE-KMS (the bucket's default KMS key).
S3_BUCKET=change-me-bucket-name
# The bucket's region (SES uses it too).
AWS_REGION=us-east-1
# Optional: how long a virus scan may take before the upload is refused, in milliseconds.
# SCAN_TIMEOUT_MS=30000

# Smoke run only (docker-compose.smoke.yml, which adds MinIO in place of S3). Generate each value for the run.
# MinIO's root account, which the API also uses as its S3 credentials there.
# MINIO_ROOT_USER=change-me-minio-user
# Generate with: openssl rand -hex 24
# MINIO_ROOT_PASSWORD=change-me-minio-password
# A name and 32 random bytes: smoke-key:<output of openssl rand -base64 32>
# MINIO_KMS_SECRET_KEY=smoke-key:change-me-run-openssl-rand-base64-32
# Where MinIO's port 9000 is published (default 127.0.0.1:9000); the smoke script reaches download links there.
# MINIO_PORT=127.0.0.1:9000
