# Copy to deploy/poc/.env and replace every change-me value.

# Caddy's site address; a real host name gets a public certificate, localhost gets Caddy's own CA.
DOMAIN=localhost
# Where users reach the app. Also the WebAuthn origin, so it must match what the browser shows.
APP_ORIGIN=https://localhost

# MongoDB root account. MONGO_URI must carry the same credentials (URL-encode special characters).
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=change-me-mongo-password
MONGO_URI=mongodb://root:change-me-mongo-password@mongo:27017/?replicaSet=rs0&authSource=admin
MONGO_DB=roadmap

NODE_ENV=production
PORT=3000
# Generate with: openssl rand -base64 32
TOTP_ENC_KEY=change-me-run-openssl-rand-base64-32

# The file mailer needs no AWS credentials: mail lands in the container's tmpfs. Production uses ses.
MAILER=file
MAIL_OUTBOX_FILE=/tmp/outbox.jsonl
MAIL_FROM=no-reply@localhost
HIBP_ENABLED=true
AUTH_RATE_LIMIT_PER_MIN=10

# Files. The compose file sets FILES=s3, SCANNER=clamd and CLAMD_HOST=clamav; S3 credentials come from the instance role.
# The bucket for uploaded files; objects are written with SSE-KMS (the bucket's default KMS key).
S3_BUCKET=change-me-bucket-name
# The bucket's region (SES uses it too).
AWS_REGION=us-east-1
# Optional: how long a virus scan may take before the upload is refused, in milliseconds.
# SCAN_TIMEOUT_MS=30000

# Optional: the address range of the network only Caddy and the API share (default 10.254.254.0/24). The API trusts
# X-Forwarded-For only from a peer in it (the compose file sets TRUSTED_PROXY_CIDR from it). If the server's own
# network, a VPN or another Docker network already uses 10.254.254.0/24, change it here to a free private range.
# PROXY_SUBNET=10.254.254.0/24

# Snapshot PDFs. The compose file sets PDF=service and PDF_URL=http://pdf:3200 for the API, and RENDER_ORIGIN for
# the pdf service (headless Chromium, mem_limit 1g); nothing to set here. The service reaches only the API and
# Caddy's internal listener on port 8080, which is never published. With ClamAV (up to 3 GB) and Chromium
# (up to 1 GB) beside MongoDB, the API and Caddy, the server needs 8 GB of memory, not 4.
# Optional: how long the PDF service gives one render, and how long the API waits for it, in milliseconds. Keep
# RENDER_TIMEOUT_MS below PDF_TIMEOUT_MS, and PDF_TIMEOUT_MS below 120000 (the render token's lifetime; the API
# refuses to start otherwise).
# RENDER_TIMEOUT_MS=45000
# PDF_TIMEOUT_MS=60000

# Notification emails. The worker service runs from the API image (node dist/worker.js), with this same file and
# the same settings the compose file gives the API, because it loads the same configuration. It needs MongoDB and
# the mailer above, nothing else, and has a 256 MB memory limit. Optional: how long it waits between passes, in
# milliseconds (its health check allows three intervals plus 150 seconds between heartbeats).
# WORKER_INTERVAL_MS=30000
# Nothing restarts an unhealthy worker in plain Compose (restart only follows an exit): watch its health yourself.

# Smoke run only (docker-compose.smoke.yml, which adds MinIO in place of S3). Generate each value for the run.
# MinIO's root account, which the API also uses as its S3 credentials there.
# MINIO_ROOT_USER=change-me-minio-user
# Generate with: openssl rand -hex 24
# MINIO_ROOT_PASSWORD=change-me-minio-password
# A name and 32 random bytes: smoke-key:<output of openssl rand -base64 32>
# MINIO_KMS_SECRET_KEY=smoke-key:change-me-run-openssl-rand-base64-32
# Where MinIO's port 9000 is published (default 127.0.0.1:9000); the smoke script reaches download links there,
# PDF download links included.
# MINIO_PORT=127.0.0.1:9000
# Where Caddy's ports 80 and 443 are published (defaults 80 and 443), for a host where those are taken.
# HTTP_PORT=80
# HTTPS_PORT=443
