{
	order rate_limit before basicauth
}

# Everything a site does: the headers, the API behind /api and the web app's files. The public site and the
# internal listener below both import it, so the PDF service sees exactly the pages people see.
(app) {
	header {
		# The same policy the API sends (apps/api/src/app.ts).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Snapshots are shared by link; search engines must not list them.
	@snapshot path /s/* /api/snapshots/*
	header @snapshot X-Robots-Tag "noindex, nofollow"

	handle /api/* {
		rate_limit {
			zone api {
				key {remote_host}
				events 100
				window 1m
			}
			# Sign-in and a snapshot's password: the same strict limit. Two match blocks: either one counts.
			zone auth {
				match {
					path /api/auth/*
				}
				match {
					path_regexp ^/api/snapshots/[^/]+/unlock$
				}
				key {remote_host}
				events 10
				window 1m
			}
		}
		# Request bodies: 1 MiB (the API's own JSON limit), except the file upload, which takes a 25 MiB file plus
		# the multipart framing. MiB, not MB: the API counts 25 * 1024 * 1024 bytes.
		@upload {
			method POST
			path_regexp ^/api/roadmaps/[^/]+/projects/[^/]+/attachments$
		}
		@not_upload not {
			method POST
			path_regexp ^/api/roadmaps/[^/]+/projects/[^/]+/attachments$
		}
		request_body @upload {
			max_size 26MiB
		}
		request_body @not_upload {
			max_size 1MiB
		}
		reverse_proxy api:3000
	}

	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}

{$DOMAIN} {
	import app
}

# The PDF service's origin (RENDER_ORIGIN=http://caddy:8080): plain HTTP, on an internal network only the PDF
# service shares with Caddy. The port is never published, and Caddy listens on it only at its address on that
# network (caddy-render, an alias the compose file gives it there), so no other container reaches it either.
# The render token travels in a request header, not a cookie, so no TLS is needed here.
http://:8080 {
	bind caddy-render
	import app
}
