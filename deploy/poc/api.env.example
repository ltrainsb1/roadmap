# Copy to deploy/poc/api.env and replace every change-me value. The api service reads it (env_file; set API_ENV_FILE
# in deploy/poc/.env to keep it elsewhere). The worker has its own file, worker.env.
#
# deploy/poc/.env is a third file, which Compose itself reads to fill in ${...} in docker-compose.yml. It is not
# passed to the containers. It holds:
#   DOMAIN=localhost                       Caddy's site address; a real host name gets a public certificate, localhost
#                                          gets Caddy's own CA.
#   S3_BUCKET=change-me-bucket-name        The bucket for uploaded files. The API sends no encryption header, so the
#                                          bucket's default encryption applies (on AWS, the project's KMS key).
#                                          Credentials come from the instance role.
#   MONGO_INITDB_ROOT_USERNAME=root        MongoDB's root account, made on a fresh data folder. Nothing in the app
#   MONGO_INITDB_ROOT_PASSWORD=change-me   connects as root; it is for backups and maintenance.
#   MONGO_APP_PASSWORD=change-me           The password of roadmap_app, the user the API and the worker connect as.
#                                          The MONGO_URI in api.env and worker.env must carry the same password
#                                          (URL-encode special characters). Set on a fresh data folder only.
#   PROXY_SUBNET=10.254.254.0/24           Optional: the address range of the network only Caddy and the API share.
#                                          The API trusts X-Forwarded-For only from a peer in it (the compose file
#                                          sets TRUSTED_PROXY_CIDR from it). If the server's own network, a VPN or
#                                          another Docker network already uses it, pick a free private range.
#   HTTP_PORT=80, HTTPS_PORT=443           Optional: where Caddy's ports are published, for a host where those are
#                                          taken.
#   PDF_TIMEOUT_MS=60000                   Optional: how long the API waits for one PDF, in milliseconds.
#   RENDER_TIMEOUT_MS=45000                Optional: how long the PDF service gives one render. Keep it below
#                                          PDF_TIMEOUT_MS, and PDF_TIMEOUT_MS below 120000 (the render token's
#                                          lifetime; the API refuses to start otherwise).
#   MONGO_DATA=/srv/mongo                  Optional: the folder for MongoDB's data.
# The smoke run only (docker-compose.smoke.yml, which adds MinIO in place of S3) also needs these in .env, each
# generated for the run: MINIO_ROOT_USER, MINIO_ROOT_PASSWORD (openssl rand -hex 24), MINIO_KMS_SECRET_KEY
# (smoke-key:<output of openssl rand -base64 32>), and optionally MINIO_PORT (default 127.0.0.1:9000).
#
# With ClamAV (up to 3 GB) and Chromium (up to 1 GB) beside MongoDB, the API and Caddy, the server needs 8 GB of
# memory, not 4.

# Where users reach the app. Also the WebAuthn origin, so it must match what the browser shows.
APP_ORIGIN=https://localhost

# The app's own MongoDB user (roadmap_app: read and write on this database only). The password is MONGO_APP_PASSWORD.
MONGO_URI=mongodb://roadmap_app:change-me-app-password@mongo:27017/roadmap?replicaSet=rs0&authSource=roadmap
MONGO_DB=roadmap

NODE_ENV=production
PORT=3000
# Generate with: openssl rand -base64 32
TOTP_ENC_KEY=change-me-run-openssl-rand-base64-32
# Signs the unsubscribe links in notification emails. The worker signs them too, so worker.env must hold the same value.
# Generate with: openssl rand -base64 32
UNSUBSCRIBE_KEY=change-me-run-openssl-rand-base64-32

# The file mailer needs no AWS credentials: mail lands in the container's tmpfs. Production uses ses.
MAILER=file
MAIL_OUTBOX_FILE=/tmp/outbox.jsonl
MAIL_FROM=no-reply@localhost
HIBP_ENABLED=true
AUTH_RATE_LIMIT_PER_MIN=10

# Files. The compose file sets FILES=s3, SCANNER=clamd and CLAMD_HOST=clamav; S3 credentials come from the instance
# role. The bucket (S3_BUCKET) is set in deploy/poc/.env.
# The bucket's region (SES uses it too).
AWS_REGION=us-east-1
# Optional: how long a virus scan may take before the upload is refused, in milliseconds.
# SCAN_TIMEOUT_MS=30000

# Snapshot PDFs. The compose file sets PDF=service and PDF_URL=http://pdf:3200 for the API, and RENDER_ORIGIN for
# the pdf service (headless Chromium, mem_limit 1g); nothing to set here. The service reaches only the API and
# Caddy's internal listener on port 8080, which is never published.

# Optional: the SES configuration set that reports bounces and complaints. Mail sent with it is counted, and the
# worker stops notification emails to an address that bounces or reports spam. Set the same name in worker.env.
# SES_CONFIGURATION_SET=roadmap
