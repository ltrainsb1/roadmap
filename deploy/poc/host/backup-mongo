#!/usr/bin/env bash
# Dumps MongoDB, encrypts it in S3 and removes the local copy:   backup-mongo
# The dump streams out of the running mongo container (as root, with the root account) into a file in
# /srv/mongo-backup (ROADMAP_BACKUP_DIR), which is on the root disk, not the data volume. It goes to
# s3://<BACKUP_BUCKET>/mongo/<UTC date>.archive.gz, where the bucket's default encryption (the project's KMS key)
# applies, and the local file is removed.
# Settings: BACKUP_BUCKET from compose.env in ROADMAP_ENV_DIR (default /run/roadmap). The region comes from
# aws-region (the instance metadata service when none is set). To reach another stack (the
# deploy-smoke job) set COMPOSE_PROJECT_NAME, COMPOSE_FILES (space-separated) and COMPOSE_ENV_FILE; the defaults
# are the server's: project roadmap-poc, the Compose files of the release in /opt/roadmap/current, and compose.env.
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
env_dir=${ROADMAP_ENV_DIR:-/run/roadmap}
root=${ROADMAP_ROOT:-/opt/roadmap}
backup_dir=${ROADMAP_BACKUP_DIR:-/srv/mongo-backup}
project=${COMPOSE_PROJECT_NAME:-roadmap-poc}
env_file=${COMPOSE_ENV_FILE:-$env_dir/compose.env}

# shellcheck source-path=SCRIPTDIR source=aws-region
. "$here/aws-region" || exit 1

# /run/roadmap is a tmpfs: after a reboot it is empty until the next deploy. Render the settings again for the
# release that is running.
if [[ ! -f "$env_dir/compose.env" ]]; then
  if [[ ! -s "$root/current" ]]; then
    echo "backup-mongo: $env_dir/compose.env is missing and there is no release in $root/current to render it for" >&2
    exit 1
  fi
  "$here/render-env" "$(cat "$root/current")" \
    || { echo "backup-mongo: could not render $env_dir/compose.env from SSM" >&2; exit 1; }
fi

bucket=$(sed -n "s/^BACKUP_BUCKET='\\(.*\\)'\$/\\1/p" "$env_dir/compose.env" 2> /dev/null | head -n 1 || true)
if [[ -z "$bucket" ]]; then
  echo "backup-mongo: BACKUP_BUCKET is not set in $env_dir/compose.env" >&2
  exit 1
fi

files=${COMPOSE_FILES:-}
if [[ -z "$files" ]]; then
  current=$(cat "$root/current")
  files="$root/releases/$current/deploy/poc/docker-compose.yml $root/releases/$current/deploy/poc/docker-compose.aws.yml"
fi
compose_args=(-p "$project")
for f in $files; do compose_args+=(-f "$f"); done
compose_args+=(--env-file "$env_file")

date=$(date -u +%F)
mkdir -p "$backup_dir"
out=$backup_dir/$date.archive.gz
# Whatever happens, no dump stays on the disk.
trap 'rm -f -- "$out"' EXIT

umask 077
if ! docker compose "${compose_args[@]}" exec -T -u root mongo bash -c \
  'exec mongodump --archive --gzip --db "$MONGO_DB" --username "$MONGO_INITDB_ROOT_USERNAME" --password "$MONGO_INITDB_ROOT_PASSWORD" --authenticationDatabase admin' > "$out"; then
  echo "backup-mongo: mongodump failed; nothing was uploaded." >&2
  exit 1
fi
if [[ ! -s "$out" ]]; then
  echo "backup-mongo: the dump is empty; nothing was uploaded." >&2
  exit 1
fi

aws s3 cp "$out" "s3://$bucket/mongo/$date.archive.gz"
echo "backup-mongo: uploaded s3://$bucket/mongo/$date.archive.gz" >&2
