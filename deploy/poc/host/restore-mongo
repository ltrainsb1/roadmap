#!/usr/bin/env bash
# Restores a backup into the running mongo container:   restore-mongo <YYYY-MM-DD> [--to <database>]
# It downloads s3://<BACKUP_BUCKET>/mongo/<date>.archive.gz and runs mongorestore --drop, which replaces the
# collections it restores. With --to the data goes into another database (a check that leaves the live one alone).
# Same settings as backup-mongo (BACKUP_BUCKET, COMPOSE_PROJECT_NAME, COMPOSE_FILES, COMPOSE_ENV_FILE).
set -euo pipefail

usage() {
  echo "usage: restore-mongo <YYYY-MM-DD> [--to <database>]" >&2
  exit 2
}

date=${1:-}
[[ "$date" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || usage
to=''
if [[ $# -eq 3 && "$2" == "--to" ]]; then
  to=$3
  [[ "$to" =~ ^[A-Za-z0-9_]+$ ]] || usage
elif [[ $# -ne 1 ]]; then
  usage
fi

env_dir=${ROADMAP_ENV_DIR:-/run/roadmap}
root=${ROADMAP_ROOT:-/opt/roadmap}
backup_dir=${ROADMAP_BACKUP_DIR:-/srv/mongo-backup}
project=${COMPOSE_PROJECT_NAME:-roadmap-poc}
env_file=${COMPOSE_ENV_FILE:-$env_dir/compose.env}

# /run/roadmap is a tmpfs: after a reboot it is empty until the next deploy. Render the settings again for the
# release that is running.
if [[ ! -f "$env_dir/compose.env" ]]; then
  if [[ ! -s "$root/current" ]]; then
    echo "restore-mongo: $env_dir/compose.env is missing and there is no release in $root/current to render it for" >&2
    exit 1
  fi
  "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/render-env" "$(cat "$root/current")" \
    || { echo "restore-mongo: could not render $env_dir/compose.env from SSM" >&2; exit 1; }
fi

bucket=$(sed -n "s/^BACKUP_BUCKET='\\(.*\\)'\$/\\1/p" "$env_dir/compose.env" 2> /dev/null | head -n 1 || true)
if [[ -z "$bucket" ]]; then
  echo "restore-mongo: BACKUP_BUCKET is not set in $env_dir/compose.env" >&2
  exit 1
fi

files=${COMPOSE_FILES:-}
if [[ -z "$files" ]]; then
  current=$(cat "$root/current")
  files="$root/releases/$current/deploy/poc/docker-compose.yml $root/releases/$current/deploy/poc/docker-compose.aws.yml"
fi
compose_args=(-p "$project")
for f in $files; do compose_args+=(-f "$f"); done
compose_args+=(--env-file "$env_file")

umask 077
mkdir -p "$backup_dir"
archive=$backup_dir/restore-$date.archive.gz
trap 'rm -f -- "$archive"' EXIT

aws s3 cp "s3://$bucket/mongo/$date.archive.gz" "$archive"

# The archive is read from standard input; the account is the container's own root account.
if [[ -z "$to" ]]; then
  docker compose "${compose_args[@]}" exec -T -u root mongo bash -c \
    'exec mongorestore --archive --gzip --drop --nsInclude "$MONGO_DB.*" --username "$MONGO_INITDB_ROOT_USERNAME" --password "$MONGO_INITDB_ROOT_PASSWORD" --authenticationDatabase admin' \
    < "$archive"
else
  docker compose "${compose_args[@]}" exec -T -u root mongo bash -c \
    'exec mongorestore --archive --gzip --drop --nsInclude "$MONGO_DB.*" --nsFrom "$MONGO_DB.*" --nsTo "$1.*" --username "$MONGO_INITDB_ROOT_USERNAME" --password "$MONGO_INITDB_ROOT_PASSWORD" --authenticationDatabase admin' \
    restore "$to" < "$archive"
fi
echo "restore-mongo: restored $date${to:+ into $to}" >&2
