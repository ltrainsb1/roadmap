# Copy to deploy/poc/worker.env and replace every change-me value. The worker service reads it (env_file; set
# WORKER_ENV_FILE in deploy/poc/.env to keep it elsewhere). The API has its own file, api.env; the Compose-level
# variables (DOMAIN, the MongoDB passwords, ports) are listed in api.env.example's header.
#
# Notification emails: the worker runs from the API image (node dist/worker.js). It needs MongoDB and the mailer,
# nothing else, and has a 256 MB memory limit. It gets none of the API's keys except UNSUBSCRIBE_KEY (no
# TOTP_ENC_KEY), and no file, scanner or PDF settings.

NODE_ENV=production
# The same roadmap_app user as the API (password: MONGO_APP_PASSWORD in deploy/poc/.env).
MONGO_URI=mongodb://roadmap_app:change-me-app-password@mongo:27017/roadmap?replicaSet=rs0&authSource=roadmap
MONGO_DB=roadmap
# Where users reach the app: the links in emails start with it.
APP_ORIGIN=https://localhost
# Signs the unsubscribe link in each email. It must be the same value as UNSUBSCRIBE_KEY in api.env, which checks the link.
# Generate with: openssl rand -base64 32
UNSUBSCRIBE_KEY=change-me-run-openssl-rand-base64-32

# The file mailer needs no AWS credentials: mail lands in the container's tmpfs. Production uses ses.
MAILER=file
MAIL_OUTBOX_FILE=/tmp/outbox.jsonl
MAIL_FROM=no-reply@localhost
# The region SES is called in.
AWS_REGION=us-east-1

# Optional: how long it waits between passes, in milliseconds (its health check allows three intervals plus 150
# seconds between heartbeats).
# WORKER_INTERVAL_MS=30000
# Nothing restarts an unhealthy worker in plain Compose (restart only follows an exit): watch its health yourself.
